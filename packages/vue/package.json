{
  "name": "@doranjs/vue",
  "version": "0.1.0",
  "description": "Idiomatic Vue 3 bindings for Doran — v-model components over the @doranjs/wc engine, plus headless composables.",
  "license": "MIT",
  "author": "Doran Contributors",
  "homepage": "https://github.com/amiralibg/Doran/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/amiralibg/Doran.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/amiralibg/Doran/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "persian",
    "jalali",
    "datepicker",
    "calendar",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@doranjs/core": "workspace:*",
    "@doranjs/wc": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vue": "^3.4.0"
  }
}
