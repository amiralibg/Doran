{
  "name": "@doranjs/nlp",
  "version": "0.0.4",
  "description": "Persian natural-language date parsing for the Solar Hijri calendar.",
  "license": "MIT",
  "author": "Doran Contributors",
  "homepage": "https://github.com/amiralibg/Doran/tree/main/packages/nlp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/amiralibg/Doran.git",
    "directory": "packages/nlp"
  },
  "bugs": {
    "url": "https://github.com/amiralibg/Doran/issues"
  },
  "keywords": [
    "persian",
    "jalali",
    "nlp",
    "date",
    "natural-language",
    "parser",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@doranjs/core": "workspace:*"
  }
}
