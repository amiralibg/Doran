{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false
  },
  "angularCompilerOptions": {
    // Full Ivy, not partial: the demo builds with @analogjs/vite-plugin-angular,
    // which skips node_modules and never runs the Angular linker, so partial
    // (ngDeclare) output would need the JIT compiler at runtime and fail. peerDep
    // is pinned to a single Angular major, where full-compiled output is stable.
    "compilationMode": "full",
    "strictTemplates": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage", "**/*.test.ts"]
}
