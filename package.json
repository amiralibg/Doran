{
  "name": "doran",
  "version": "0.0.0",
  "private": true,
  "description": "The Open Source Persian Calendar Ecosystem",
  "license": "MIT",
  "author": "Doran Contributors",
  "homepage": "https://github.com/amiralibg/Doran#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/amiralibg/Doran.git"
  },
  "bugs": {
    "url": "https://github.com/amiralibg/Doran/issues"
  },
  "keywords": [
    "persian",
    "jalali",
    "shamsi",
    "solar-hijri",
    "calendar",
    "date",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "size": "node scripts/size-check.mjs",
    "bench": "node packages/core/bench/index.mjs",
    "demos:smoke": "node scripts/demos-smoke.mjs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.2",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "playwright": "^1.61.1",
    "prettier": "^3.4.2",
    "tsdown": "^0.22.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "unrun": "^0.3.0",
    "vitest": "^3.0.2"
  }
}
